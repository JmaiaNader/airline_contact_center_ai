# Copy to .streamlit/secrets.toml and replace placeholders locally.
# NEVER commit .streamlit/secrets.toml. It contains credentials and the bootstrap allow-list.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_RANDOM_SECRET_FROM_PYTHON_SECRETS_TOKEN_URLSAFE"
expose_tokens = []

[auth.google]
client_id = "REPLACE_WITH_GOOGLE_OAUTH_WEB_CLIENT_ID"
client_secret = "REPLACE_WITH_GOOGLE_OAUTH_WEB_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[aeroinsight_oidc.providers.google]
identity_provider_code = "google_oidc"
issuer_url = "https://accounts.google.com"
button_label = "Continue with Google"

# One-time first-admin bootstrap. Replace with YOUR Google account email locally.
# The Google ID token must contain email_verified=true and a live exp/iat window.
# Once a Company Admin is assigned (or the bootstrap audit event exists), this path is permanently closed.
[aeroinsight_bootstrap]
enabled = true
tenant_code = "demo_airline"
admin_email = "REPLACE_WITH_YOUR_VERIFIED_GOOGLE_EMAIL"
