# App
APP_ENV=development
APP_NAME=Airline Contact Center AI Platform
DEFAULT_EMPLOYEE_LANGUAGE=en

# MySQL: no password is provided in this example.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_airlines

DB_USER=root
DB_PASSWORD=root
DB_CONNECT_TIMEOUT=5

# LLM provider: ollama | openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OPENAI_API_KEY=
OPENAI_MODEL=

# Local document retrieval (to be implemented later)
CHROMA_PERSIST_DIRECTORY=./local_data/chroma
